{
  "manifest_version": 3,
  "name": "LexiClip",
  "version": "0.0.1",
  "description": "Save unknown words from any webpage into your personal vocabulary.",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
